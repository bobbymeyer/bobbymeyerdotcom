---
import { ClientRouter } from 'astro:transitions';
import { normalizePath } from '@/utils/normalize-path';
import Mark from '@/components/Mark.astro';
import { DESCRIPTION, GITHUB, LEDE, NAME, pageTitle } from '@/site';
import { OG_HEIGHT, OG_WIDTH } from '@/lib/og';
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  /**
   * What this page is called, on its own: `about`, `🐼 pandatone`. The site
   * adds the signature — see `pageTitle` — so nothing passes one itself. The
   * index passes nothing and is the handle alone.
   */
  title?: string;
  description?: string;
  /** The social card. Defaults to the site's; a project passes its own. */
  image?: string;
  ogType?: 'website' | 'article';
}

const { title, description = DESCRIPTION, image, ogType = 'website' } = Astro.props;

/** The card every page that is not a project shares. */
const SITE_CARD = '/og/site.png';

const documentTitle = pageTitle(title);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? SITE_CARD, Astro.site);

// The alt describes the card, which is not the same thing as describing the
// page: about and contact carry the site's card, so theirs reads the name and
// the line under it, whatever the page itself is called.
const ogImageAlt = image ? `${title} — ${description}` : `${NAME} — ${LEDE}`;

const path = normalizePath(Astro.url.pathname);

// The nav marks a section, not just a page. A project page and a tag page are
// both the projects section, and until now neither lit anything: a reader deep
// in /posts/pandatone had no indication of where in the site they were.
//
// `page` is reserved for the index itself, since that is the only one of the
// three that *is* the projects page; the rest take the generic `true`, which
// is what aria-current has for "you are in here somewhere".
const isHome = path === '/';
const isProjects = isHome || path.startsWith('/posts/') || path.startsWith('/tags/');
const isAbout = path === '/about';
const isContact = path === '/contact' || path.startsWith('/contact/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    {/* `initial-scale=1` so a page opens at its own scale rather than zoomed
        out to some remembered one, and no `maximum-scale`: pinching in on a
        line of type is somebody's way of reading, not a bug to design out. */}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* The ground this page opens on — see `--ground`. Safari paints the bar
        above the page with it, so the chrome starts where the paper does. */}
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    {/* Absolute, PNG and 1200×630: the three things every platform insists on. */}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {/* The roman latin face carries nearly every page; the rest load on demand. */}
    <link
      rel="preload"
      href="/fonts/archivo-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* iOS will not take the SVG, and a home screen has no white under it —
        so the mark is rasterised onto its own ground at the one size Apple
        asks for. Drawn from the same favicon at build time, in
        `src/pages/apple-touch-icon.png.ts`, so the two cannot drift. */}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={NAME}
      href="/rss.xml"
    />
    <title>{documentTitle}</title>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <a class="site-lockup" href="/">
        <Mark />
        <span class="site-name">{NAME}</span>
      </a>
      <nav class="site-header-nav" aria-label="Site">
        <a
          href="/"
          aria-current={isHome ? 'page' : isProjects ? 'true' : undefined}
        >
          <span class="site-accent-slot" aria-hidden="true">
            {isProjects && (
              <span
                class="site-accent site-accent--projects"
                aria-hidden="true"
                transition:name="site-accent"
                transition:animate="fade"
              >●</span>
            )}
          </span>
          <span class="site-nav-label">projects</span>
        </a>
        <a
          href="/about"
          aria-current={isAbout ? 'page' : undefined}
        >
          <span class="site-accent-slot" aria-hidden="true">
            {isAbout && (
              <span
                class="site-accent site-accent--about"
                aria-hidden="true"
                transition:name="site-accent"
                transition:animate="fade"
              >●</span>
            )}
          </span>
          <span class="site-nav-label">about</span>
        </a>
        <a
          href="/contact"
          aria-current={isContact ? 'page' : undefined}
        >
          <span class="site-accent-slot" aria-hidden="true">
            {isContact && (
              <span
                class="site-accent site-accent--contact"
                aria-hidden="true"
                transition:name="site-accent"
                transition:animate="fade"
              >●</span>
            )}
          </span>
          <span class="site-nav-label">contact</span>
        </a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer" transition:persist="site-footer">
      {/*
        Short labels here, unlike the about page, which writes the address out
        in full because it sits in a sentence where the destination is the
        point. A footer is a row of names, and "RSS" is already one.
      */}
      <nav class="site-footer-nav" aria-label="Elsewhere">
        <a href={GITHUB.url} rel="noopener">GitHub</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </footer>
    <slot name="end" />
  </body>
</html>

<script>
  import '@/scripts/site-accent';

  /*
   * The whole filter lives here rather than on the index, because half its
   * job is to run *before* the index arrives: `initFilterPreSwap` narrows the
   * incoming grid while a reader is still standing on the page they followed
   * the tag link from, and the index's own script does not exist yet at that
   * point — it comes with the page and runs after the swap.
   *
   * The wiring rides along in the same block instead of staying behind on the
   * index. Split across two entry points the module becomes a shared chunk,
   * which is one more request in front of the index's own script, and the
   * grid gets painted unnarrowed while it is fetched. One owner, one request,
   * and `initProjectFilter` steps aside on every page that has no grid.
   */
  import { initFilterPreSwap, initProjectFilter } from '@/scripts/project-filter';
  initFilterPreSwap();
  document.addEventListener('astro:page-load', initProjectFilter);
  initProjectFilter();
</script>
