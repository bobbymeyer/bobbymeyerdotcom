---
import { ClientRouter } from 'astro:transitions';
import { normalizePath } from '@/utils/normalize-path';
import Mark from '@/components/Mark.astro';
import { DESCRIPTION, GITHUB, LEDE, NAME, pageTitle } from '@/site';
import { OG_HEIGHT, OG_WIDTH } from '@/lib/og';
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  /**
   * What this page is called, on its own: `about`, `🐼 pandatone`. The site
   * adds the signature — see `pageTitle` — so nothing passes one itself. The
   * index passes nothing and is the handle alone.
   */
  title?: string;
  description?: string;
  /** The social card. Defaults to the site's; a project passes its own. */
  image?: string;
  ogType?: 'website' | 'article';
}

const { title, description = DESCRIPTION, image, ogType = 'website' } = Astro.props;

/** The card every page that is not a project shares. */
const SITE_CARD = '/og/site.png';

const documentTitle = pageTitle(title);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? SITE_CARD, Astro.site);

// The alt describes the card, which is not the same thing as describing the
// page: about and contact carry the site's card, so theirs reads the name and
// the line under it, whatever the page itself is called.
const ogImageAlt = image ? `${title} — ${description}` : `${NAME} — ${LEDE}`;

const path = normalizePath(Astro.url.pathname);
const isHome = path === '/';
const isAbout = path === '/about';
const isContact = path === '/contact' || path.startsWith('/contact/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    {/* Absolute, PNG and 1200×630: the three things every platform insists on. */}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {/* The roman latin face carries nearly every page; the rest load on demand. */}
    <link
      rel="preload"
      href="/fonts/archivo-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={NAME}
      href="/rss.xml"
    />
    <title>{documentTitle}</title>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <a class="site-lockup" href="/">
        <Mark />
        <span class="site-name">{NAME}</span>
      </a>
      <nav class="site-header-nav" aria-label="Site">
        <a
          href="/"
          aria-current={isHome ? 'page' : undefined}
          data-accent-target={isHome ? '' : undefined}
        >
          <span class="site-accent-slot" aria-hidden={!isHome}>
            {isHome && (
              <span
                class="site-accent site-accent--projects"
                aria-hidden="true"
                transition:name="site-accent"
                transition:animate="fade"
              >●</span>
            )}
          </span>
          <span class="site-nav-label">projects</span>
        </a>
        <a
          href="/about"
          aria-current={isAbout ? 'page' : undefined}
          data-accent-target={isAbout ? '' : undefined}
        >
          <span class="site-accent-slot" aria-hidden={!isAbout}>
            {isAbout && (
              <span
                class="site-accent site-accent--about"
                aria-hidden="true"
                transition:name="site-accent"
                transition:animate="fade"
              >●</span>
            )}
          </span>
          <span class="site-nav-label">about</span>
        </a>
        <a
          href="/contact"
          aria-current={isContact ? 'page' : undefined}
          data-accent-target={isContact ? '' : undefined}
        >
          <span class="site-accent-slot" aria-hidden={!isContact}>
            {isContact && (
              <span
                class="site-accent site-accent--contact"
                aria-hidden="true"
                transition:name="site-accent"
                transition:animate="fade"
              >●</span>
            )}
          </span>
          <span class="site-nav-label">contact</span>
        </a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer" transition:persist="site-footer">
      {/*
        Short labels here, unlike the about page, which writes the address out
        in full because it sits in a sentence where the destination is the
        point. A footer is a row of names, and "RSS" is already one.
      */}
      <nav class="site-footer-nav" aria-label="Elsewhere">
        <a href={GITHUB.url} rel="noopener">GitHub</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </footer>
    <slot name="end" />
  </body>
</html>

<script>
  import '@/scripts/site-accent';
</script>
