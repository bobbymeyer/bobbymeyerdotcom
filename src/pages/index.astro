---
import Base from '@/layouts/Base.astro';
import ProjectIndex from '@/components/ProjectIndex.astro';
import { projectEntries } from '@/lib/project-entries';
import { interestsFrom, orderInterests } from '@/lib/interests';
import { DESCRIPTION, LEDE, NAME, PLACE } from '@/site';
import '@/styles/home.css';

const projects = await projectEntries();

// The filter row is ordered by weight: the tags with the most behind them are
// the ones worth offering first, and the singles trail off the end.
const tags = orderInterests(interestsFrom(projects), 'greatest');
---

<Base description={DESCRIPTION}>
  <main class="home">
    {/*
      Who this is, before what he made. The index used to open on the word
      "projects" and leave a first-time visitor to find the about page to
      learn whose they were.
    */}
    <header class="home-intro">
      <h1>{NAME}</h1>
      <p class="home-lede">{LEDE}</p>
      <p class="home-place">{PLACE} — <a href="/contact">say hello</a></p>
    </header>

    <ProjectIndex projects={projects} tags={tags} heading="projects" headingLevel="h2" />
  </main>
</Base>
