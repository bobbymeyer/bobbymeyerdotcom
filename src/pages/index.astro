---
import Base from '@/layouts/Base.astro';
import { projectEntries } from '@/lib/project-entries';
import { formatPostDate } from '@/utils/format-post-date';
import '@/styles/home.css';

const projects = await projectEntries();
---

<Base title="Bobby Meyer" description="Projects by Bobby Meyer, newest change first.">
  <main class="home">
    <h1 class="home-title">projects</h1>
    <div class="home-index">
      {projects.map((project) => (
        <a class="home-item" href={project.href}>
          <div
            class="splash"
            style={`--post-color: ${project.bg}`}
            transition:name={`splash-${project.slug}`}
          >
            {project.splash && <img src={project.splash} alt="" />}
          </div>
          <div class="home-item-copy">
            <h2 transition:name={`title-${project.slug}`}>
              {project.title}{project.version && <sup>v{project.version}</sup>}
            </h2>
            <p transition:name={`summary-${project.slug}`}>{project.summary}</p>
            <p class="home-item-meta">
              <span class="home-item-date">
                <span class="visually-hidden">Last change </span>
                {formatPostDate(project.updated)}
              </span>
              {project.timeline.length > 0 && (
                <span class="home-item-count">
                  {project.timeline.length === 1
                    ? '1 merged pull request'
                    : `${project.timeline.length} merged pull requests`}
                </span>
              )}
            </p>
          </div>
        </a>
      ))}
    </div>
  </main>
</Base>
