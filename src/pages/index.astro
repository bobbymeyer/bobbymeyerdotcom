---
import Base from '@/layouts/Base.astro';
import Mark from '@/components/Mark.astro';
import { projectEntries } from '@/lib/project-entries';
import { formatPostDate } from '@/utils/format-post-date';
import { interestsFrom, isKind, kindsOnly, orderInterests, topicsOnly } from '@/lib/interests';
import { DESCRIPTION, LEDE, NAME, PLACE } from '@/site';
import '@/styles/home.css';

const projects = await projectEntries();

// The dropdown lists tags by weight: the ones with the most behind them are
// worth offering first, and the singles trail off the end. Kinds — "project",
// and "post" when there are any — are held apart from the subjects, because
// "what is this" and "what is it about" are different questions, and read as
// one list "project 9" looks like a topic he is extremely into.
const interests = interestsFrom(projects);
const kinds = orderInterests(kindsOnly(interests), 'greatest');
const tags = orderInterests(topicsOnly(interests), 'greatest');

// A legend entry only earns its place if something on the page wears the mark
// it explains.
const anyInteractive = projects.some((project) => project.interactive);
const anyFeatured = projects.some((project) => project.featured);
---

<Base description={DESCRIPTION}>
  <main class="home">
    {/*
      Who this is, before what he made. The index used to open on the word
      "projects" and leave a first-time visitor to find the about page to
      learn whose they were.
    */}
    <header class="home-intro">
      <h1>{NAME}</h1>
      <p class="home-lede">{LEDE}</p>
      <p class="home-place">{PLACE} — <a href="/contact">say hello</a></p>
    </header>

    {/* The heading and the filter share a line and the rule under it. The
        panel is absolutely positioned against this row, so opening it lays
        the options over the grid rather than shoving it down the page. */}
    <div class="home-head">
      <h2 class="home-title">
        projects
        {(anyInteractive || anyFeatured) && (
          <span class="home-legend">
            {anyInteractive && (
              <Fragment>
                <span class="mark-badge home-legend-mark"><Mark class="mark--spread" /></span> = interactive preview{anyFeatured ? ',' : ''}
              </Fragment>
            )}
            {anyInteractive && anyFeatured && ' '}
            {anyFeatured && (
              <Fragment>
                <span class="mark-badge home-legend-mark"><span class="mark-star">★</span></span> = featured
              </Fragment>
            )}
          </span>
        )}
      </h2>

      {/*
      There is one filtered view of the projects and it is this page with a
      query on it. Static pages under /tags were the other half of that job
      for about an hour: two URLs for one idea, two code paths to keep in
      step, and a dropdown that behaved differently depending on which you
      were standing on.

      A disclosure rather than a row of every tag — fifteen chips above the
      grid is a wall, and this is a thing a reader reaches for occasionally.
      Closed it is one word and, when something is ticked, a count.

      Ticking tags narrows: a project has to carry all of them. On nine
      projects most second picks land on nothing, so an option that would take
      the result to zero is disabled as the selection changes, and a reader
      cannot click their way into an empty page.

      The whole grid is rendered and the browser hides what does not match, so
      with scripting off every project is listed and reachable and the only
      thing missing is the narrowing.
    */}
      {(tags.length > 0 || kinds.length > 1) && (
        <details class="home-filter" data-project-filter>
          <summary class="home-filter-summary">
            <span>filter</span>
            <span class="home-filter-badge" data-filter-badge hidden></span>
          </summary>
          <div class="home-filter-panel">
            {/* One kind with everything in it is not worth offering. The
                group appears the first time there are two to tell apart. */}
            {kinds.length > 1 && (
              <fieldset class="home-filter-set home-filter-set--kinds">
                <legend class="home-filter-legend">kind</legend>
                {kinds.map((interest) => (
                  <label class="home-filter-option">
                    <input type="checkbox" value={interest.tag} data-filter-tag />
                    <span class="home-filter-name">{interest.tag}</span>
                    <span class="home-filter-count" aria-hidden="true">{interest.count}</span>
                    <span class="visually-hidden">
                      {interest.count === 1 ? '1 entry' : `${interest.count} entries`}
                    </span>
                  </label>
                ))}
              </fieldset>
            )}
            <fieldset class="home-filter-set">
              <legend class={kinds.length > 1 ? 'home-filter-legend' : 'visually-hidden'}>
                {kinds.length > 1 ? 'about' : 'Show projects tagged'}
              </legend>
              {tags.map((interest) => (
                <label class="home-filter-option">
                  <input type="checkbox" value={interest.tag} data-filter-tag />
                  <span class="home-filter-name">{interest.tag}</span>
                  <span class="home-filter-count" aria-hidden="true">{interest.count}</span>
                  <span class="visually-hidden">
                    {interest.count === 1 ? '1 project' : `${interest.count} projects`}
                  </span>
                </label>
              ))}
            </fieldset>
            <p class="home-filter-actions">
              <a class="home-filter-clear" href="/" data-filter-clear>show everything</a>
            </p>
          </div>
        </details>
      )}
    </div>

    {/* Only reachable by a hand-written `?tags=` — the dropdown will not take
        you here — but a grid that silently emptied would look broken. */}
    <p class="home-empty" data-filter-empty hidden>
      No project carries all of those tags.
    </p>

    <div class="home-index" data-project-grid>
      {projects.map((project) => (
        <a
          class="home-item"
          href={project.href}
          data-archived={project.repo.archived ? '' : undefined}
          data-tags={project.tags.join(' ')}
        >
          <div
            class="splash"
            style={`--post-color: ${project.bg}`}
            transition:name={`splash-${project.slug}`}
          >
            {project.splash && <img src={project.splash} alt="" />}
            {/*
              One badge, two things said at once. The silhouette is whether
              the project is featured — a star, or a circle when it is not.
              The plates are whether it runs in the page: three inks slightly
              out of register when it does, one flat magenta when it does not.
              Three marks for four states, and the fourth — neither — wears
              nothing, as it should.

              The word rides along for a screen reader, because a shape is
              not a label and the only other place either fact shows is the
              order, which nobody can hear.
            */}
            {(project.interactive || project.featured) && (
              <span class="mark-badge splash-mark">
                {project.interactive ? (
                  <Mark shape={project.featured ? 'star' : 'dot'} />
                ) : (
                  <span class="mark-star" aria-hidden="true">★</span>
                )}
                <span class="visually-hidden">
                  {project.featured && project.interactive
                    ? 'Featured, and interactive'
                    : project.featured
                      ? 'Featured'
                      : 'Interactive'}
                </span>
              </span>
            )}
          </div>
          <div class="home-item-copy">
            <h3 transition:name={`title-${project.slug}`}>
              {project.title}{project.version && <sup>v{project.version}</sup>}
            </h3>
            {project.repo.archived && <p class="archived-note">archived</p>}
            <p class="home-item-summary" transition:name={`summary-${project.slug}`}>{project.summary}</p>
            {/*
              Tags are set here, not linked. The whole card is already one
              anchor, and an anchor cannot hold another — the dropdown above is
              where a tag is something you can press.
            */}
            {/* Subjects, not kinds: "project" is on all nine at once and so
                says nothing on any of them. */}
            {project.tags.some((tag) => !isKind(tag)) && (
              <p class="home-item-tags">
                {project.tags.filter((tag) => !isKind(tag)).map((tag) => (
                  <span class="home-item-tag" data-tag={tag}>{tag}</span>
                ))}
              </p>
            )}
            <p class="home-item-meta">
              <span class="home-item-date">
                <span class="visually-hidden">Last change </span>
                {formatPostDate(project.updated)}
              </span>
              {project.timeline.length > 0 && (
                <span class="home-item-count">
                  {project.timeline.length === 1
                    ? '1 merged pull request'
                    : `${project.timeline.length} merged pull requests`}
                </span>
              )}
            </p>
          </div>
        </a>
      ))}
    </div>
  </main>
</Base>

<script>
  import { initProjectFilter } from '@/scripts/project-filter';
  document.addEventListener('astro:page-load', initProjectFilter);
  initProjectFilter();
</script>
