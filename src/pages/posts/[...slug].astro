---
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Timeline from '@/components/Timeline.astro';
import { projectEntries, type ProjectEntry } from '@/lib/project-entries';
import { formatPostDate } from '@/utils/format-post-date';
import '@/styles/post.css';
import '@/styles/project.css';

export async function getStaticPaths() {
  return (await projectEntries()).map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props as { project: ProjectEntry };
const Note = project.note ? (await render(project.note)).Content : null;

// An interactive note declares a sketch; its stylesheet sits beside the
// project's assets in public/, named for the sketch, loaded only on the page
// that runs it.
const sketch = project.note?.data.sketch;
const sketchCss = sketch ? `/posts/${project.slug}/${sketch}.css` : null;
---

<Base
  title={project.title}
  description={project.summary}
  image={`/og/${project.slug}.png`}
  ogType="article"
>
  {sketchCss && <link slot="head" rel="stylesheet" href={sketchCss} />}
  <main
    class="post project"
    style={`--post-color: ${project.bg}`}
    data-archived={project.repo.archived ? '' : undefined}
  >
    <div class="post-layout project-layout">
      <header class="project-header">
        <h1 transition:name={`title-${project.slug}`}>
          {project.title}{project.version && <sup>v{project.version}</sup>}
        </h1>
        {project.repo.archived && <p class="archived-note">archived</p>}
        <p class="post-date">
          {formatPostDate(project.published)}
          <span class="post-updated">updated {formatPostDate(project.updated)}</span>
        </p>
        <p class="post-summary" transition:name={`summary-${project.slug}`}>{project.summary}</p>
      </header>

      <aside class="post-aside">
        <div class="splash" transition:name={`splash-${project.slug}`}>
          {project.splash && <img src={project.splash} alt="" />}
        </div>
        <dl class="project-facts">
          <dt>Source</dt>
          <dd>
            <a href={project.repo.url} rel="noopener">{project.repo.nameWithOwner}</a>
          </dd>
          {project.repo.homepage && (
            <Fragment>
              <dt>Live</dt>
              <dd>
                <a href={project.repo.homepage} rel="noopener">
                  {project.repo.homepage.replace(/^https?:\/\//, '').replace(/\/$/, '')}
                </a>
              </dd>
            </Fragment>
          )}
          {project.version && (
            <Fragment>
              <dt>Release</dt>
              <dd>
                {project.versionUrl
                  ? <a href={project.versionUrl} rel="noopener">v{project.version}</a>
                  : `v${project.version}`}
              </dd>
            </Fragment>
          )}
          {project.repo.language && (
            <Fragment>
              <dt>Written in</dt>
              <dd>{project.repo.language}</dd>
            </Fragment>
          )}
        </dl>

        {/* The merges belong with the repository's other facts, under the
            splash, rather than in a rail of their own beside the readme. */}
        <Timeline entries={project.timeline} repoUrl={project.repo.url} />
      </aside>

      <div class="post-main">
        {Note && (
          <article class="post-article project-note">
            <Note />
          </article>
        )}

        {project.readmeHtml && (
          <article class="post-article project-readme">
            <h2 class="project-section">readme</h2>
            <Fragment set:html={project.readmeHtml} />
          </article>
        )}
      </div>
    </div>
  </main>
</Base>

<script>
  import { initPostLayout } from '@/scripts/post-layout';
  document.addEventListener('astro:page-load', initPostLayout);
  initPostLayout();
</script>

<script>
  // No-op on pages without a #song-container, so it's safe to ship everywhere.
  import { initBusStops } from '@/scripts/bus-stops';
  document.addEventListener('astro:page-load', initBusStops);
  initBusStops();
</script>

<script>
  // No-op without an #albers-container.
  import { initAlbers } from '@/scripts/albers';
  document.addEventListener('astro:page-load', initAlbers);
  initAlbers();
</script>

<script>
  // No-op without a #treegen.
  import { initTreegen } from '@/scripts/treegen';
  document.addEventListener('astro:page-load', initTreegen);
  initTreegen();
</script>
