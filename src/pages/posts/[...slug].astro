---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { formatPostDate } from '@/utils/format-post-date';
import '@/styles/post.css';

const slugOf = (id: string) => id.replace(/\.mdx?$/, '');

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.mdx?$/, '') },
    props: { post },
  }));
}

type Post = Awaited<ReturnType<typeof getCollection<'posts'>>>[number];
const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const slug = slugOf(post.id);
---

<Base title={post.data.title} description={post.data.summary} image={post.data.splash} ogType="article">
  <main class="post" style={`--post-color: ${post.data.bg_color}`}>
    <div class="post-layout">
      <aside class="post-aside">
        <div class="splash" transition:name={`splash-${slug}`}>
          {post.data.splash && <img src={post.data.splash} alt="" />}
        </div>
      </aside>
      <div class="post-main">
        {!post.data.hide_header && (
          <header>
            <h1 transition:name={`title-${slug}`}>
              {post.data.title}{post.data.version && <sup>v{post.data.version}</sup>}
            </h1>
            <p class="post-date">
              {formatPostDate(post.data.date)}
              {post.data.updated && <span class="post-updated">updated {formatPostDate(post.data.updated)}</span>}
            </p>
            <p class="post-summary" transition:name={`summary-${slug}`}>{post.data.summary}</p>
          </header>
        )}
        <article class="post-article">
          <Content />
        </article>
      </div>
    </div>
  </main>
</Base>

<script>
  import { initPostLayout } from '@/scripts/post-layout';
  document.addEventListener('astro:page-load', initPostLayout);
  initPostLayout();
</script>
