---
/**
 * A bench for trying the index as a wheel before the index has to be one.
 *
 * The real cards, in the real order, with the knobs out where they can be
 * turned: how far the column bends, how fast a card shrinks with distance,
 * how close they stack, how quickly they fade. Settle the numbers here by eye
 * and the index takes them; nothing on this page is meant to stay.
 *
 * Built everywhere except the production deploy. Netlify sets CONTEXT to
 * `production` there and to `deploy-preview` or `branch-deploy` otherwise, so
 * a preview carries the bench to a phone and bobbymeyer.com never does.
 */
import Base from '@/layouts/Base.astro';
import { projectEntries } from '@/lib/project-entries';
import { formatPostDate } from '@/utils/format-post-date';
import { isFacet } from '@/lib/interests';
import '@/styles/wheel.css';

export function getStaticPaths() {
  return process.env.CONTEXT === 'production' ? [] : [{ params: { page: 'wheel' } }];
}

const projects = await projectEntries();

/** Splashes fetched with the page; the rest wait. See ABOVE_FOLD on the index. */
const NEAR = 3;
---

<Base title="wheel" description="A bench for the index as a wheel.">
  <meta slot="head" name="robots" content="noindex" />
  <main class="wheel-page">
    <header class="wheel-intro">
      <h1>wheel</h1>
      <p>
        The index as a wheel turning at the right-hand edge of the page: the
        current project full size, the rest riding round the rim and shrinking
        with distance. Scroll, drag, or use the arrow keys.
      </p>
    </header>

    <section class="wheel-track" data-wheel aria-label="Projects">
      <div class="wheel-stage" data-wheel-stage>
        {/* A plain ordered list of links. Without scripting it is just that;
            the script lays it out as the wheel. */}
        <ol class="wheel-list">
          {projects.map((project, position) => (
            <li class="wheel-item" data-wheel-item>
              <a class="wheel-card" href={project.href}>
                <div class="splash" style={`--post-color: ${project.bg}`}>
                  {project.splash && (
                    <img
                      src={project.splash}
                      alt=""
                      loading={position < NEAR ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  )}
                </div>
                <div class="wheel-copy">
                  <h3>{project.title}{project.version && <sup>v{project.version}</sup>}</h3>
                  <p class="wheel-summary">{project.summary}</p>
                  {project.tags.some((tag) => !isFacet(tag)) && (
                    <p class="wheel-tags">
                      {project.tags.filter((tag) => !isFacet(tag)).map((tag) => (
                        <span>{tag}</span>
                      ))}
                    </p>
                  )}
                  <p class="wheel-meta">{formatPostDate(project.updated)}</p>
                </div>
              </a>
            </li>
          ))}
        </ol>

        {/* The knobs. Lives on the stage so it stays put while the wheel
            turns under it. */}
        <details class="wheel-tune" open>
          <summary>tune</summary>
          <div class="wheel-tune-body">
            <label>
              <span>arc</span>
              <input type="range" min="0" max="1" step="0.01" value="1" data-tune="arc" />
              <output data-tune-out="arc"></output>
            </label>
            <label>
              <span>wheel size</span>
              <input type="range" min="0.6" max="3" step="0.05" value="1" data-tune="size" />
              <output data-tune-out="size"></output>
            </label>
            <label>
              <span>shrink</span>
              <input type="range" min="0.4" max="1" step="0.01" value="0.72" data-tune="shrink" />
              <output data-tune-out="shrink"></output>
            </label>
            <label>
              <span>spacing</span>
              <input type="range" min="0.3" max="1.4" step="0.01" value="1.1" data-tune="spacing" />
              <output data-tune-out="spacing"></output>
            </label>
            <label>
              <span>fade</span>
              <input type="range" min="0" max="0.6" step="0.01" value="0.22" data-tune="fade" />
              <output data-tune-out="fade"></output>
            </label>
            <label>
              <span>scroll per item</span>
              <input type="range" min="0.2" max="1" step="0.05" value="0.35" data-tune="travel" />
              <output data-tune-out="travel"></output>
            </label>
            <p class="wheel-tune-readout" data-tune-readout></p>
          </div>
        </details>
      </div>
    </section>

    <p class="wheel-after">That is everything.</p>
  </main>
</Base>

<script>
  import { initWheel } from '@/scripts/wheel';
  document.addEventListener('astro:page-load', initWheel);
  initWheel();
</script>
