---
import Base from '@/layouts/Base.astro';
import '@/styles/mark-pair.css';
import '@/styles/notfound.css';

const description = 'Page not found.';
---

<Base title="not found" description={description}>
  <main class="notfound">
    <div class="notfound-main">
      {/* Decorative: the heading underneath says the same thing in words, and
          a screen reader meeting a lone "?!" would only be read punctuation. */}
      <p class="mark-pair notfound-glyphs" aria-hidden="true">
        <span class="mark-pair-mark mark-pair-mark--first notfound-glyph--ask">?</span>
        <span class="mark-pair-mark mark-pair-mark--second notfound-glyph--bang">!</span>
      </p>
      <h1>uh oh, this page is missing.</h1>
      <h2 class="notfound-code">404 error</h2>
      <p class="notfound-back"><a href="/">back to the index</a></p>
    </div>
    {/* Hidden until the script runs: without it there is nothing to drag, and
        the page above already says everything it needs to. */}
    <figure class="misprint" data-misprint hidden>
      <canvas
        tabindex="0"
        role="img"
        aria-label="The address you asked for, printed in cyan, magenta and yellow plates. Drag it, or use the arrow keys, to pull the plates out of register."
      ></canvas>
      <figcaption>
        the address you asked for, in three plates. drag them apart.
      </figcaption>
    </figure>
  </main>
</Base>

<script>
  import { initMisprint } from '@/scripts/misprint';

  document.addEventListener('astro:page-load', initMisprint);
</script>
