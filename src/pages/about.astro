---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import { GITHUB, NAME } from '@/site';
import { projectEntries } from '@/lib/project-entries';
import {
  DEFAULT_INTEREST_ORDER,
  INTEREST_ORDERS,
  interestRanks,
  interestsFrom,
  orderInterests,
  tagHref,
  topicsOnly,
} from '@/lib/interests';
import portrait from '@/assets/portrait.jpg';
import '@/styles/post.css';
import '@/styles/about.css';

const description = `About ${NAME}.`;

// Topics only. Every note also carries a kind — "project", and "post" when
// there are any — which says what a thing is rather than what it is about,
// and is nobody's interest.
const interests = topicsOnly(interestsFrom(await projectEntries()));
const ranks = interestRanks(interests);

// Rendered in the default order, so the list is right before a line of
// JavaScript has run and right if none ever does. The ranks ride along on each
// tag; the script reorders against them.
const listed = orderInterests(interests, DEFAULT_INTEREST_ORDER);
---

<Base title="about" description={description}>
  <main class="post">
    <div class="post-layout">
      <aside class="post-aside">
        <figure class="about-portrait">
          {/*
            The slot, measured rather than guessed: 609px once the page stops
            growing at 1600, 47vw of the four-column grid above 1200, and the
            whole width of the page below it, where the aside spans the grid.
            A `(min-width: 640px) 50vw` stop used to sit in here describing a
            two-column split the portrait has never taken, which had a tablet
            asking for an image half the size of the one it was about to show.
          */}
          <Image
            src={portrait}
            alt="Black-and-white portrait of Bobby Meyer in a palm-print shirt, looking off to one side."
            widths={[600, 900, 1200]}
            sizes="(min-width: 1600px) 609px, (min-width: 1200px) 47vw, 100vw"
            loading="eager"
          />
        </figure>
      </aside>
      <div class="post-main">
        <header>
          <h1>about</h1>
        </header>
        <article class="post-article about-copy">
          {/*
            The one place on the site that sets his name in capitals: this is
            the formal statement of who this is, not the chrome. Everywhere
            else takes NAME from src/site.ts, lowercase. See CLAUDE.md.
          */}
          <p class="about-statement">
            Bobby Meyer. Based in Ojai, California. I build systems that make
            things. Some of them are useful. Some of them are not.
          </p>

          {interests.length > 0 && (
            <div class="about-interests">
              <p class="about-interests-lead">
                This site documents my{' '}
                <span class="about-select">
                  <label class="visually-hidden" for="interest-order">
                    Order my interests by
                  </label>
                  <select id="interest-order" data-interest-order>
                    {INTEREST_ORDERS.map((option) => (
                      <option value={option.value} selected={option.value === DEFAULT_INTEREST_ORDER}>
                        {option.label}
                      </option>
                    ))}
                  </select>
                </span>{' '}
                interests:
              </p>
              <ul class="about-tags" data-interest-list>
                {listed.map((interest) => (
                  <li
                    class="about-tag"
                    data-rank-greatest={ranks.greatest[interest.tag]}
                    data-rank-recent={ranks.recent[interest.tag]}
                  >
                    <a href={tagHref(interest.tag)}>
                      {interest.tag}
                      <span class="visually-hidden">
                        {interest.count === 1 ? ' — 1 project' : ` — ${interest.count} projects`}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <p>
            <a href="/">See what I’ve been building.</a>
          </p>
          {/*
            The index is only the projects he chose to put on it; the profile
            is everything else. A project page already links to its own
            repository, so this is the one link on the site that answers
            "what else is there".
          */}
          <p>
            Or find the rest on <a href={GITHUB.url} rel="noopener">{GITHUB.label}</a>.
          </p>
          <p>
            Want to talk? <a href="/contact">Say hello</a>.
          </p>
        </article>
      </div>
    </div>
  </main>
</Base>

<script>
  import { initInterestOrder } from '@/scripts/interest-order';
  document.addEventListener('astro:page-load', initInterestOrder);
  initInterestOrder();
</script>
