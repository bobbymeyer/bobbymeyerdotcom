---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import InterestList from '@/components/InterestList.astro';
import { GITHUB, NAME } from '@/site';
import { projectEntries } from '@/lib/project-entries';
import { INTEREST_ORDERS, STACK_ORDERS, interestsFrom, stackOnly, topicsOnly } from '@/lib/interests';
import portrait from '@/assets/portrait.jpg';
import '@/styles/post.css';
import '@/styles/about.css';

const description = `About ${NAME}.`;

// Two tallies, the same shape: what the work is about, and what it is built
// with. Kinds and marks are in neither — "project" says what a thing is rather
// than what it is about, and is nobody's interest.
const counted = interestsFrom(await projectEntries());
const interests = topicsOnly(counted);
const stack = stackOnly(counted);
---

<Base title="about" description={description}>
  <main class="post">
    {/*
      The article before the portrait. Below 1200px the two stack in source
      order, and with the aside first the page opened on a photograph and made
      a first-time visitor scroll to find out whose it was. It is the reading
      order a screen reader and an unstyled page get as well, so it is fixed
      here rather than with an `order` in the stylesheet. Above 1200px both
      columns are placed explicitly, so the desktop layout does not notice.
    */}
    <div class="post-layout">
      <div class="post-main">
        <header>
          <h1>about</h1>
        </header>
        <article class="post-article about-copy">
          {/*
            The one place on the site that sets his name in capitals: this is
            the formal statement of who this is, not the chrome. Everywhere
            else takes NAME from src/site.ts, lowercase. See CLAUDE.md.
          */}
          <p class="about-statement">
            Bobby Meyer. Based in Ojai, California. I build systems that make
            things. Some of them are useful. Some of them are not.
          </p>

          {interests.length > 0 && (
            <InterestList
              id="interest-order"
              label="Order my interests by"
              before="This site documents my "
              after=" interests:"
              orders={INTEREST_ORDERS}
              interests={interests}
            />
          )}

          {/*
            The same sentence again for the toolchain, because it is the same
            fact counted out of the other vocabulary. Subjects are what he is
            drawn to; tools are what he reached for, so the orders are said as
            "Usually" and "Lately" rather than "greatest" and "recent".

            This one opens on the word instead of burying it mid-sentence:
            "I have usually been building with" put an adverb between the
            auxiliary and its participle and read like a sentence being
            reversed into. At the front it is the thing being said.
          */}
          {stack.length > 0 && (
            <InterestList
              id="stack-order"
              label="Order what I build with by"
              before=""
              after=" I build with:"
              orders={STACK_ORDERS}
              interests={stack}
            />
          )}

          <p>
            <a href="/">See what I’ve been building.</a>
          </p>
          {/*
            The index is only the projects he chose to put on it; the profile
            is everything else. A project page already links to its own
            repository, so this is the one link on the site that answers
            "what else is there".
          */}
          <p>
            Or find the rest on <a href={GITHUB.url} rel="noopener">{GITHUB.label}</a>.
          </p>
          <p>
            Want to talk? <a href="/contact">Say hello</a>.
          </p>
        </article>
      </div>
      <aside class="post-aside">
        <figure class="about-portrait">
          {/*
            The slot, measured rather than guessed: 609px once the page stops
            growing at 1600, 47vw of the four-column grid above 1200, and the
            whole width of the page below it, where the aside spans the grid.
            A `(min-width: 640px) 50vw` stop used to sit in here describing a
            two-column split the portrait has never taken, which had a tablet
            asking for an image half the size of the one it was about to show.
          */}
          <Image
            src={portrait}
            alt="Black-and-white portrait of Bobby Meyer in a palm-print shirt, looking off to one side."
            widths={[600, 900, 1200]}
            sizes="(min-width: 1600px) 609px, (min-width: 1200px) 47vw, 100vw"
            loading="eager"
          />
        </figure>
      </aside>
    </div>
  </main>
</Base>

<script>
  import { initInterestOrder } from '@/scripts/interest-order';
  document.addEventListener('astro:page-load', initInterestOrder);
  initInterestOrder();
</script>
