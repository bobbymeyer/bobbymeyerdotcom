---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import { LEDE, NAME, PLACE } from '@/site';
import portrait from '@/assets/portrait.jpg';
import '@/styles/post.css';
import '@/styles/about.css';

const description = `About ${NAME}.`;
---

<Base title="about" description={description}>
  <main class="post">
    <div class="post-layout">
      <aside class="post-aside">
        <figure class="about-portrait">
          <Image
            src={portrait}
            alt="Black-and-white portrait of Bobby Meyer in a palm-print shirt, looking off to one side."
            widths={[600, 900, 1200]}
            sizes="(min-width: 1600px) 609px, (min-width: 1200px) 47vw, (min-width: 640px) 50vw, 100vw"
            loading="eager"
          />
        </figure>
      </aside>
      <div class="post-main">
        <header>
          <h1>about</h1>
        </header>
        <article class="post-article">
          {/*
            The same two lines the index opens with, from src/site.ts, so the
            page and the index cannot drift apart. This is a placeholder for
            an about page, not an about page — see TODO.md, where rewriting it
            is the first thing on the list.
          */}
          <p>I’m {NAME}. {LEDE}</p>
          <p>
            I’m based in {PLACE} — <a href="/contact">say hello</a>.
          </p>
        </article>
      </div>
    </div>
  </main>
</Base>
