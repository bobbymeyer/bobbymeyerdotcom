---
/**
 * A registration target — the crosshair a printer puts outside the trim so
 * they can see at a glance whether the plates are landing on top of one
 * another. Here it means the same kind of thing: this one has moving parts,
 * and they line up on the project's own page.
 *
 * It sits on the splash, over artwork this file knows nothing about, so it is
 * drawn white over a dark halo rather than in any of the site's inks — the
 * halo is what keeps it on a pale splash, and the white is what keeps it on a
 * dark one.
 *
 * Decorative by default: the index already says, in the legend beside its
 * heading, what the mark means, and a screen reader meeting it once per card
 * would only be read the same sentence eight times. The legend itself passes
 * `decorative={false}` to name it once.
 */
interface Props {
  class?: string;
  decorative?: boolean;
}

const { class: className, decorative = true } = Astro.props;

const labelled = decorative
  ? ({ 'aria-hidden': true } as const)
  : ({ role: 'img', 'aria-label': 'Registration target' } as const);
---

<svg
  class:list={['reg-mark', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  {...labelled}
>
  <path d="M12 0.5v23M0.5 12h23" />
  <circle cx="12" cy="12" r="7" />
  <circle cx="12" cy="12" r="2.6" />
</svg>
